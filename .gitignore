# Derived indexes and temporary/atomic data files.
# Canonical application data, including SQLite and migration backups, is tracked.
data/.cache/
data/**/*.tmp
data/**/*.staging
data/**/*.lock
data/**/*.sqlite-wal
data/**/*.sqlite-shm
